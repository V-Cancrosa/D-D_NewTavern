<form autocomplete="off" class="new-tavern-form">
  <p class="notes">MG tworzy przedmiot osadzony bezpośrednio na wybranej karcie postaci.</p>
  <div class="form-group"><label>Postać</label><select name="actorId" required>{{#each actors}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></div>
  <div class="form-group"><label>Nazwa przedmiotu</label><input name="name" required autofocus placeholder="np. Pierścień ochrony"></div>
  <div class="form-group"><label>Typ</label><select name="type">{{#each types}}<option value="{{this}}">{{this}}</option>{{/each}}</select></div>
  <div class="form-group"><label>Ilość</label><input name="quantity" type="number" min="1" value="1"></div>
  <div class="form-group"><label>Ikona przedmiotu</label><input name="img" value="icons/svg/item-bag.svg"></div>
  <div class="form-group"><label>Opis</label><textarea name="description" rows="3"></textarea></div>
  <hr><h3>Aktywny efekt</h3>
  <div class="form-group"><label>Nazwa efektu</label><input name="effect.name" placeholder="np. Ochrona"></div>
  <div class="form-group"><label>Ikona efektu</label><input name="effect.icon" value="icons/svg/aura.svg"></div>
  <div class="form-group"><label>Efekt przenoszony z przedmiotu</label><input name="effect.transfer" type="checkbox" checked></div>
  <div class="form-group"><label>Klucz zmiany</label><input name="effect.key" placeholder="np. system.attributes.ac.bonus"></div>
  <div class="form-group"><label>Tryb</label><select name="effect.mode">{{#each modes}}<option value="{{value}}">{{label}}</option>{{/each}}</select></div>
  <div class="form-group"><label>Wartość</label><input name="effect.value" placeholder="np. 1"></div>
  <div class="form-group"><label>Priorytet</label><input name="effect.priority" type="number" value="20"></div>
  <footer class="sheet-footer flexrow"><button type="submit"><i class="fas fa-save"></i> Dodaj przedmiot do postaci</button></footer>
</form>