<div class="nt-win">

  {{!-- Nagłówek: nazwa, (folder), postęp, pytanie --}}
  <header class="nt-head">
    {{#if is.start}}
    <input type="text" class="nt-title nt-title-input" data-field="item.name" value="{{s.item.name}}"
           placeholder="Nazwa przedmiotu" aria-label="Nazwa przedmiotu" autofocus>
    {{#if showFolder}}
    <select class="nt-folder" data-field="destination.folder" aria-label="Folder">
      <option value="">Folder: —</option>
      {{#each folders}}<option value="{{id}}" {{#if selected}}selected{{/if}}>Folder: {{name}}</option>{{/each}}
    </select>
    {{/if}}
    {{else}}
    <span class="nt-title nt-name">{{name}}</span>
    {{/if}}
    {{#if dots.length}}
    <div class="nt-dots" aria-hidden="true">{{#each dots}}<span class="nt-dot {{cls}}"></span>{{/each}}</div>
    {{/if}}
    <span class="nt-question">{{#if editing}}{{#if is.overview}}{{#if ownerName}}Na karcie: {{ownerName}} · {{/if}}{{/if}}{{/if}}{{stepLabel}}</span>
  </header>

  <section class="nt-scroll">

    {{!-- 1. CO TWORZYSZ --}}
    {{#if is.start}}
    <ol class="nt-card nt-list">
      {{#each itemTypes}}
      <li>
        <button type="button" class="nt-row {{#if active}}active{{/if}}" data-action="itemType" data-value="{{value}}" aria-pressed="{{active}}">
          <dnd5e-icon class="nt-ic" src="{{icon}}"></dnd5e-icon>
          <span class="nt-lb">{{label}}<span class="nt-hint">{{hint}}</span></span>
          <span class="nt-radio {{#if active}}on{{/if}}" aria-hidden="true"></span>
        </button>
      </li>
      {{/each}}
    </ol>
    <details class="nt-card" {{#if compendiumOpen}}open{{/if}}>
      <summary class="nt-more">…albo zacznij od przedmiotu z kompendium ({{typeLabel}}, {{rulesLabel}})</summary>
      <div class="nt-pad nt-top-pad">
        <input type="text" class="nt-search" data-field="search" value="{{s.search}}" placeholder="Szukaj po nazwie, np. pierścień" aria-label="Szukaj w kompendiach">
      </div>
      <ol class="nt-list">
        {{#each compendium}}
        <li>
          <button type="button" class="nt-row {{#if active}}active{{/if}}" data-action="fromCompendium" data-uuid="{{uuid}}">
            <img class="nt-thumb" src="{{img}}" alt="">
            <span class="nt-lb">{{name}}<span class="nt-hint">{{rarityLabel}} · {{pack}}</span></span>
            <span class="nt-radio {{#if active}}on{{/if}}" aria-hidden="true"></span>
          </button>
        </li>
        {{else}}
        <li><p class="nt-note">Brak magicznych przedmiotów tego rodzaju w kompendiach dla tych zasad{{#if s.search}} pasujących do „{{s.search}}”{{/if}}.</p></li>
        {{/each}}
      </ol>
      {{#if compendiumMore}}<p class="nt-note">…i {{compendiumMore}} więcej – zawęź wyszukiwanie.</p>{{/if}}
      <p class="nt-note nt-muted">Kreator robi kopię – oryginał w kompendium zostaje bez zmian.</p>
    </details>
    {{#if presets.length}}
    <details class="nt-card" {{#if s.preset}}open{{/if}}>
      <summary class="nt-more">…albo z gotowego szablonu modułu</summary>
      <ol class="nt-list">
        {{#each presets}}
        <li>
          <button type="button" class="nt-row {{#if active}}active{{/if}}" data-action="preset" data-preset="{{id}}">
            <span class="nt-lb">{{label}}<span class="nt-hint">{{hint}}</span></span>
            <span class="nt-radio {{#if active}}on{{/if}}" aria-hidden="true"></span>
          </button>
        </li>
        {{/each}}
      </ol>
    </details>
    {{/if}}
    {{/if}}

    {{!-- 2. PODSTAWY --}}
    {{#if is.basics}}
    <div class="nt-card">
      <div class="nt-legend">Opis przedmiotu · {{typeLabel}}</div>
      <div class="nt-fg">
        <span>Obraz</span>
        <button type="button" class="nt-portrait" data-action="pickImage" aria-label="Zmień obraz"><img src="{{img}}" alt=""></button>
      </div>
      {{#if subtypes.length}}
      <label class="nt-fg"><span>Podtyp</span>
        <select data-field="item.subtype"><option value="">—</option>
          {{#each subtypes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </label>
      {{/if}}
      {{#if baseItems.length}}
      <label class="nt-fg"><span>Przedmiot bazowy</span>
        <select data-field="item.baseItem"><option value="">—</option>
          {{#each baseItems}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </label>
      <p class="nt-note nt-muted">Wybór uzupełnia obrażenia, właściwości, zasięg, wagę i cenę{{#if isArmor}} oraz KP{{/if}} – jak w karcie systemu.</p>
      {{/if}}
      <label class="nt-fg"><span>Rzadkość</span>
        <select data-field="item.rarity"><option value="">—</option>
          {{#each rarities}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </label>
      <label class="nt-fg"><span>Dostrojenie</span>
        <select data-field="item.attunement"><option value="">nie wymaga</option>
          {{#each attunements}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </label>
      <label class="nt-fg"><span>Zasady</span>
        <select data-field="item.rules">{{#each rulesOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      </label>
      {{#if rulesMismatch}}<p class="nt-note nt-warn">Świat używa zasad {{worldRules}}. Przedmiot zostanie oznaczony jako przedmiot z drugiej wersji zasad – nic nie zostanie przerobione automatycznie.</p>{{/if}}
      <div class="nt-fg"><span>Cena</span>
        <span class="nt-inline nt-grow"><input type="number" min="0" class="nt-num nt-wide-num" data-field="item.price" data-dtype="Number" value="{{s.item.price}}" aria-label="Cena"> sz
          {{#if priceMedian}}<button type="button" class="nt-chip" data-action="applyPrice" data-value="{{priceMedian}}" data-tooltip="{{priceHint}}">wstaw {{priceMedian}} sz</button>{{/if}}
        </span>
      </div>
      {{#if priceHint}}<p class="nt-note nt-muted">Podpowiedź: {{priceHint}}.</p>{{/if}}
      <label class="nt-fg"><span>Ilość</span>
        <input type="number" min="1" class="nt-num" data-field="item.quantity" data-dtype="Number" value="{{s.item.quantity}}">
      </label>
      <label class="nt-fg"><span>Magiczny</span>
        <input type="checkbox" class="nt-check" data-field="item.magical" {{#if s.item.magical}}checked{{/if}}>
      </label>
    </div>

    {{#if isWeapon}}
    <div class="nt-card">
      <div class="nt-legend">Broń</div>
      <div class="nt-sentence">Obrażenia
        <input type="number" min="0" class="nt-num" data-field="item.damage.count" data-dtype="Number" value="{{s.item.damage.count}}" aria-label="Liczba kości">
        <select data-field="item.damage.die" data-dtype="Number" aria-label="Kość">{{#each weaponDice}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        <select data-field="item.damage.type" aria-label="Rodzaj obrażeń">{{#each weaponDamageTypes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      </div>
      {{#if isVersatile}}
      <div class="nt-sentence">Oburęcznie
        <input type="number" min="0" class="nt-num" data-field="item.versatile.count" data-dtype="Number" value="{{s.item.versatile.count}}" aria-label="Kości oburęcznie">
        <select data-field="item.versatile.die" data-dtype="Number" aria-label="Kość oburęcznie"><option value="0">—</option>{{#each versatileDice}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      </div>
      {{/if}}
      {{#if masteries.length}}
      <label class="nt-fg nt-top"><span>Mistrzostwo</span>
        <select data-field="item.mastery"><option value="">—</option>{{#each masteries}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      </label>
      {{/if}}
    </div>
    {{/if}}
    {{#if isArmor}}
    <div class="nt-card">
      <div class="nt-legend">{{#if isShield}}Tarcza{{else}}Zbroja{{/if}}</div>
      <label class="nt-fg"><span>{{#if isShield}}Premia do KP{{else}}KP zbroi{{/if}}</span>
        <input type="number" min="0" class="nt-num" data-field="item.armor.value" data-dtype="Number" value="{{s.item.armor.value}}">
      </label>
      {{#unless isShield}}
      <label class="nt-fg"><span>Maks. premia ZRC</span>
        <input type="number" min="0" class="nt-num" data-field="item.armor.dex" value="{{s.item.armor.dex}}" placeholder="∞" aria-label="Maksymalna premia ze Zręczności">
      </label>
      <label class="nt-fg"><span>Wymagana Siła</span>
        <input type="number" min="0" class="nt-num" data-field="item.armor.strength" data-dtype="Number" value="{{s.item.armor.strength}}">
      </label>
      {{/unless}}
      <p class="nt-note {{#if armorMissing}}nt-warn{{/if}}">{{#if armorMissing}}Podaj KP – bez niego system policzy KP od zera, czyli niżej niż bez zbroi. {{/if}}{{armorPreview}}</p>
    </div>
    {{/if}}
    {{#if hasMagicalBonus}}
    <div class="nt-card">
      <label class="nt-fg"><span>Premia magiczna</span>
        <span class="nt-inline">+<input type="number" min="0" max="5" class="nt-num" data-field="item.magicalBonus" data-dtype="Number" value="{{s.item.magicalBonus}}"></span>
      </label>
      <p class="nt-note">{{#if isWeapon}}Dodaje się do trafienia i obrażeń.{{else}}Dodaje się do KP zbroi lub tarczy.{{/if}}</p>
    </div>
    {{/if}}

    <details class="nt-card" data-ui="secret" {{#if secretOpen}}open{{/if}}>
      <summary class="nt-more">Identyfikacja i klątwa{{#if secretSummary}} <span class="nt-hint">– {{secretSummary}}</span>{{/if}}</summary>
      <label class="nt-fg nt-top"><span>Niezidentyfikowany</span>
        <input type="checkbox" class="nt-check" data-field="item.unidentified" {{#if s.item.unidentified}}checked{{/if}}>
      </label>
      {{#if s.item.unidentified}}
      <label class="nt-fg"><span>Nazwa dla graczy</span><input type="text" data-field="item.unidName" value="{{s.item.unidName}}" placeholder="np. Zakurzony pierścień"></label>
      <div class="nt-pad"><textarea rows="2" data-field="item.unidDescription" placeholder="Co gracze widzą przed identyfikacją" aria-label="Opis przed identyfikacją">{{s.item.unidDescription}}</textarea></div>
      <p class="nt-note nt-muted">{{#if gmIdentify}}Gracze nie mogą zidentyfikować przedmiotu sami – MG robi to z menu ⋮ przy przedmiocie.{{else}}Gracze mogą zidentyfikować przedmiot sami (ustawienie modułu).{{/if}}</p>
      {{/if}}
      <label class="nt-fg nt-top"><span>Przeklęty</span>
        <input type="checkbox" class="nt-check" data-field="item.curse.active" {{#if s.item.curse.active}}checked{{/if}}>
      </label>
      {{#if s.item.curse.active}}
      <label class="nt-sentence nt-light"><input type="checkbox" class="nt-check" data-field="item.curse.sticky" {{#if s.item.curse.sticky}}checked{{/if}}> Nie da się zdjąć, odłączyć ani wyrzucić, dopóki klątwa trwa</label>
      <label class="nt-sentence nt-light"><input type="checkbox" class="nt-check" data-field="item.curse.status" {{#if s.item.curse.status}}checked{{/if}}> Nadaje postaci stan „przeklęty”</label>
      {{#if editing}}<label class="nt-sentence nt-light"><input type="checkbox" class="nt-check" data-field="item.curse.revealed" {{#if s.item.curse.revealed}}checked{{/if}}> Klątwa ujawniona graczom</label>{{/if}}
      <div class="nt-pad"><textarea rows="3" data-field="item.curse.note" placeholder="Na czym polega klątwa (widzi tylko MG)" aria-label="Opis klątwy">{{s.item.curse.note}}</textarea></div>
      <p class="nt-note nt-muted">Skutki klątwy (np. −2 do rzutów obronnych) dodaj w kroku „Premie i efekty”. Ujawnienie i zdjęcie klątwy: menu ⋮ przy przedmiocie na karcie postaci.</p>
      {{/if}}
    </details>

    {{#if hasMore}}
    <details class="nt-card" data-ui="more" {{#if s.ui.more}}open{{/if}}>
      <summary class="nt-more">Więcej opcji</summary>
      {{#if propertyOptions.length}}
      <div class="nt-legend">Właściwości</div>
      <div class="nt-pills nt-pad">
        {{#each propertyOptions}}<button type="button" class="nt-chip {{#if active}}active{{/if}}" data-action="toggleProp" data-value="{{value}}">{{label}}</button>{{/each}}
      </div>
      {{/if}}
      {{#if isWeapon}}
      <label class="nt-fg nt-top"><span>Biegłość</span>
        <select data-field="item.proficient">{{#each proficiencyOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      </label>
      <div class="nt-fg"><span>Zasięg</span>
        <span class="nt-inline">{{#if isRanged}}
          <input type="number" min="0" class="nt-num" data-field="item.range.value" value="{{s.item.range.value}}" aria-label="Zasięg normalny"> /
          <input type="number" min="0" class="nt-num" data-field="item.range.long" value="{{s.item.range.long}}" aria-label="Zasięg daleki"> ft
          {{else}}wręcz <input type="number" min="0" class="nt-num" data-field="item.range.reach" value="{{s.item.range.reach}}" aria-label="Zasięg wręcz"> ft{{/if}}
        </span>
      </div>
      {{/if}}
      {{#if isArmor}}
      <label class="nt-fg nt-top"><span>Biegłość</span>
        <select data-field="item.proficient">{{#each proficiencyOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      </label>
      {{/if}}
      <label class="nt-fg"><span>Waga</span><span class="nt-inline"><input type="number" min="0" step="0.1" class="nt-num" data-field="item.weight" data-dtype="Number" value="{{s.item.weight}}"> lb</span></label>
    </details>
    {{/if}}

    {{#if impact}}
    <div class="nt-tip nt-impact">
      <div class="nt-legend nt-flush">Wpływ na: {{impact.actorName}}</div>
      {{#if impact.error}}<p class="nt-line nt-muted">Nie udało się policzyć wpływu ({{impact.error}}).</p>{{/if}}
      {{#each impact.rows}}
      <div class="nt-irow"><span>{{label}}</span><span class="nt-muted">{{before}}</span><span aria-hidden="true">→</span><span class="nt-{{cls}}">{{after}}</span></div>
      {{/each}}
      {{#each impact.notes}}<div class="nt-line nt-muted">{{this}}</div>{{/each}}
      {{#each impact.warnings}}<div class="nt-line nt-warn">⚠ {{this}}</div>{{/each}}
      <div class="nt-line nt-muted nt-small">Liczone na kopii postaci w pamięci – nic nie jest zapisywane.</div>
    </div>
    {{/if}}

    <div class="nt-card">
      <div class="nt-legend">Opis dla gracza</div>
      <div class="nt-pad"><textarea rows="4" data-field="item.description" aria-label="Opis">{{s.item.description}}</textarea></div>
    </div>
    {{/if}}

    {{!-- 3. CO ROBI --}}
    {{#if is.intents}}
    <ol class="nt-card nt-list">
      {{#each intents}}
      <li>
        <button type="button" class="nt-row nt-row-tall {{#if active}}active{{/if}}" data-action="intent" data-value="{{id}}"
                aria-pressed="{{active}}" {{#if disabled}}disabled{{/if}}>
          <i class="nt-ic {{icon}}" aria-hidden="true"></i>
          <span class="nt-lb">{{label}}<span class="nt-hint">{{hint}}</span></span>
          <span class="nt-box {{#if active}}on{{/if}}" aria-hidden="true">{{#if active}}<i class="fa-solid fa-check"></i>{{/if}}</span>
        </button>
      </li>
      {{/each}}
    </ol>
    <div class="nt-card">
      <p class="nt-note">
        {{#if isLoot}}Łup w dnd5e nie ma użycia ani ładunków – można mu dać tylko premie.{{/if}}
        {{#if plannedSteps.length}}Dalej pokażemy tylko potrzebne kroki: <b>{{#each plannedSteps}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</b>.
        {{else}}Nic nie zaznaczono – przedmiot będzie zwykłym przedmiotem bez efektów.{{/if}}
      </p>
    </div>
    {{/if}}

    {{!-- 4. PREMIE I EFEKTY --}}
    {{#if is.effects}}
    {{#if effect}}
    <div class="nt-card">
      <label class="nt-fg"><span>Efekt</span>
        <span class="nt-inline nt-grow">
          {{#if effects.length}}
          <select data-field="current" aria-label="Wybierz efekt">{{#each effects}}<option value="{{index}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>
          {{/if}}
          <button type="button" class="nt-icon" data-action="addEffect" data-tooltip="Nowy efekt" aria-label="Nowy efekt"><i class="fa-solid fa-plus"></i></button>
          <button type="button" class="nt-icon" data-action="removeEffect" data-tooltip="Usuń efekt" aria-label="Usuń efekt"><i class="fa-solid fa-trash"></i></button>
        </span>
      </label>
      <label class="nt-fg"><span>Nazwa</span><input type="text" data-field="effects.{{effectIndex}}.name" value="{{effect.name}}"></label>
      <label class="nt-fg"><span>Działa</span>
        <select data-field="effectMode">{{#each effectModes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      </label>
      {{#if timed}}
      <div class="nt-sentence">
        {{#if showDurationValue}}Trwa
        <input type="number" min="1" class="nt-num" data-field="effects.{{effectIndex}}.duration.value" data-dtype="Number" value="{{effect.duration.value}}" aria-label="Czas trwania">
        <select data-field="effects.{{effectIndex}}.duration.units" aria-label="Jednostka">{{#each durationUnits}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        {{/if}}
        {{#if v14}}{{#if showDurationValue}}i kończy się{{else}}Kończy się{{/if}}
        <select data-field="effects.{{effectIndex}}.duration.expiry" aria-label="Kiedy się kończy">{{#each expiries}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        {{/if}}
      </div>
      {{/if}}
    </div>

    <div class="nt-card nt-table">
      <div class="nt-thead"><span class="nt-c1">Zmiana</span><span class="nt-c2">Typ</span><span class="nt-c3">Wartość</span></div>
      {{#unless rows.length}}<p class="nt-note">Brak zmian. Dodaj pierwszą złotym przyciskiem „+”.</p>{{/unless}}
      {{#each rows}}
      <div class="nt-tr-wrap {{#if open}}open{{/if}}" data-row="{{index}}">
        {{#if isRaw}}
        <div class="nt-tr nt-raw">
          <span class="nt-c1">{{sentence}}</span>
          <button type="button" class="nt-icon" data-action="removeRow" aria-label="Usuń zmianę"><i class="fa-solid fa-xmark"></i></button>
        </div>
        {{else}}
        <button type="button" class="nt-tr" data-action="openRow" aria-expanded="{{open}}">
          <span class="nt-c1">{{label}}</span><span class="nt-c2">{{opLabel}}</span><span class="nt-c3">{{value}}</span>
        </button>
        {{#if open}}
        <div class="nt-ed">
          <div class="nt-inline nt-grow">
            <select data-field="effects.{{@root.effectIndex}}.rows.{{index}}.target" aria-label="Co zmienia" class="nt-grow">
              {{#each groups}}<optgroup label="{{label}}">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>{{/each}}
            </select>
            <button type="button" class="nt-icon" data-action="removeRow" data-tooltip="Usuń zmianę" aria-label="Usuń zmianę"><i class="fa-solid fa-trash"></i></button>
          </div>
          <div class="nt-pills">
            {{#each ops}}<button type="button" class="nt-pill {{#if active}}active{{/if}}" data-action="rowSet" data-key="op" data-value="{{value}}">{{label}}</button>{{/each}}
          </div>
          {{#if isSet}}
          <div class="nt-pills">
            {{#each tags}}<button type="button" class="nt-chip {{#if active}}active{{/if}}" data-action="toggleTag" data-value="{{value}}">{{label}}</button>{{/each}}
          </div>
          {{/if}}
          {{#if showKinds}}
          <div class="nt-seg" role="group" aria-label="Rodzaj wartości">
            {{#each kinds}}<button type="button" class="{{#if active}}active{{/if}}" data-action="rowSet" data-key="kind" data-value="{{value}}">{{label}}</button>{{/each}}
          </div>
          {{/if}}
          {{#if isNumber}}
          <div class="nt-stepper">
            <button type="button" data-action="rowStep" data-dir="-1" aria-label="Mniej">−</button>
            <input type="number" class="nt-num" data-field="effects.{{@root.effectIndex}}.rows.{{index}}.num" data-dtype="Number" value="{{num}}" aria-label="Wartość">
            <button type="button" data-action="rowStep" data-dir="1" aria-label="Więcej">+</button>
          </div>
          {{/if}}
          {{#if isDice}}
          <div class="nt-pills">
            <span class="nt-stepper">
              <button type="button" data-action="rowStep" data-dir="-1" aria-label="Mniej kości">−</button>
              <b class="nt-count">{{count}}</b>
              <button type="button" data-action="rowStep" data-dir="1" aria-label="Więcej kości">+</button>
            </span>
            {{#each dice}}<button type="button" class="nt-chip {{#if active}}active{{/if}}" data-action="rowSet" data-key="die" data-value="{{value}}">{{label}}</button>{{/each}}
          </div>
          {{/if}}
          {{#if isFormula}}
          <div class="nt-pills">
            {{#each refs}}<button type="button" class="nt-chip {{#if active}}active{{/if}}" data-action="rowSet" data-key="ref" data-value="{{value}}">{{label}}</button>{{/each}}
          </div>
          {{/if}}
          <div class="nt-say">„{{sentence}}”</div>
        </div>
        {{/if}}
        {{/if}}
      </div>
      {{/each}}
      <details class="nt-statuses" data-ui="statuses" {{#if s.ui.statuses}}open{{/if}}>
        <summary class="nt-tr nt-muted">Nadaje stany: {{statusText}}</summary>
        <div class="nt-pills nt-pad">
          {{#each statuses}}<button type="button" class="nt-chip {{#if active}}active{{/if}}" data-action="toggleStatus" data-value="{{id}}">{{label}}</button>{{/each}}
        </div>
      </details>
      <button type="button" class="nt-gold" data-action="addRow" data-tooltip="Dodaj zmianę" aria-label="Dodaj zmianę"><i class="fa-solid fa-plus"></i></button>
    </div>
    {{else}}
    <div class="nt-card"><p class="nt-note">Brak efektów.</p>
      <div class="nt-pad"><button type="button" class="nt-btn" data-action="addEffect"><i class="fa-solid fa-plus"></i> Dodaj efekt</button></div>
    </div>
    {{/if}}
    {{/if}}

    {{!-- 5. UŻYCIE --}}
    {{#if is.usage}}
    <ol class="nt-card nt-list">
      {{#each usageKinds}}
      <li>
        <button type="button" class="nt-row {{#if active}}active{{/if}}" data-action="usageKind" data-value="{{value}}" aria-pressed="{{active}}">
          <dnd5e-icon class="nt-ic nt-ic-sm" src="{{icon}}"></dnd5e-icon>
          <span class="nt-lb">{{label}}</span>
          <span class="nt-radio {{#if active}}on{{/if}}" aria-hidden="true"></span>
        </button>
      </li>
      {{/each}}
    </ol>
    {{#if isWeaponUsage}}<p class="nt-note">Atak bronią system dodaje sam – tu wybierasz dodatkowe działanie przedmiotu (np. leczenie, rzut obronny).</p>{{/if}}
    {{#if onlyUtility}}<p class="nt-note">Przedmiot nakłada efekt czasowy, więc jego użycie po prostu go włącza. Zaznacz „Można go użyć” w kroku 3, aby dodać leczenie, obrażenia lub rzut obronny.</p>{{/if}}
    <div class="nt-card">
      {{#if u.heal}}
      <div class="nt-legend">Leczenie</div>
      <div class="nt-sentence">Leczy
        <input type="number" min="0" class="nt-num" data-field="usage.heal.count" data-dtype="Number" value="{{s.usage.heal.count}}" aria-label="Liczba kości">
        <select data-field="usage.heal.die" data-dtype="Number" aria-label="Kość">{{#each healDice}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        + <input type="text" class="nt-short" data-field="usage.heal.bonus" value="{{s.usage.heal.bonus}}" placeholder="0" aria-label="Premia"> PW
      </div>
      {{/if}}
      {{#if u.save}}
      <div class="nt-legend">Rzut obronny</div>
      <div class="nt-sentence">Cel rzuca na
        <select data-field="usage.save.ability" aria-label="Atrybut">{{#each abilities}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        ST <input type="number" min="1" class="nt-num" data-field="usage.save.dc" data-dtype="Number" value="{{s.usage.save.dc}}" aria-label="ST">
      </div>
      {{/if}}
      {{#if u.damage}}
      <div class="nt-legend">Obrażenia</div>
      <div class="nt-sentence">
        <input type="number" min="0" class="nt-num" data-field="usage.damage.count" data-dtype="Number" value="{{s.usage.damage.count}}" aria-label="Liczba kości">
        <select data-field="usage.damage.die" data-dtype="Number" aria-label="Kość">{{#each damageDice}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        + <input type="text" class="nt-short" data-field="usage.damage.bonus" value="{{s.usage.damage.bonus}}" placeholder="0" aria-label="Premia">
        <select data-field="usage.damage.type" aria-label="Rodzaj obrażeń">{{#each usageDamageTypes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      </div>
      {{#if u.save}}
      <div class="nt-sentence">Po udanym rzucie
        <select data-field="usage.save.onSave" aria-label="Po udanym rzucie">
          <option value="half" {{#if onSaveHalf}}selected{{/if}}>połowa obrażeń</option>
          <option value="none" {{#unless onSaveHalf}}selected{{/unless}}>bez obrażeń</option>
        </select>
      </div>
      {{/if}}
      {{/if}}
      <div class="nt-sentence">
        {{#if hasCharges}}Zużywa <input type="number" min="0" class="nt-num" data-field="usage.cost" data-dtype="Number" value="{{s.usage.cost}}" aria-label="Koszt w ładunkach"> ład., jako{{else}}Użycie:{{/if}}
        <select data-field="usage.activation" aria-label="Czas użycia">{{#each activations}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      </div>
      {{#if hasCharges}}{{#unless u.utility}}
      <label class="nt-sentence nt-light"><input type="checkbox" class="nt-check" data-field="usage.scaling" {{#if s.usage.scaling}}checked{{/if}}> Każdy dodatkowy ładunek wzmacnia efekt (+1 kość)</label>
      {{/unless}}{{/if}}
    </div>
    {{/if}}

    {{!-- 6. ŁADUNKI --}}
    {{#if is.charges}}
    <div class="nt-card">
      <div class="nt-legend">Ile i kiedy wracają</div>
      <div class="nt-sentence">
        <input type="number" min="1" class="nt-num" data-field="uses.max" data-dtype="Number" value="{{s.uses.max}}" aria-label="Maks. ładunków"> ładunków; odnawia
        <input type="text" class="nt-short" data-field="uses.formula" value="{{s.uses.formula}}" placeholder="wszystkie" aria-label="Ile wraca">
        <select data-field="uses.recovery" aria-label="Kiedy"><option value="">nigdy</option>{{#each periods}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      </div>
      <div class="nt-charges" aria-hidden="true">{{#each chargeDots}}<span></span>{{/each}}</div>
      <p class="nt-note">Puste pole „odnawia” = wracają wszystkie. Kości wpisuj jak na sesji, np. 1k6+1.</p>
      {{#if isConsumable}}
      <label class="nt-sentence nt-light nt-top"><input type="checkbox" class="nt-check" data-field="uses.autoDestroy" {{#if s.uses.autoDestroy}}checked{{/if}}> Znika po zużyciu ostatniego ładunku</label>
      {{/if}}
    </div>
    <div class="nt-card">
      <div class="nt-legend">Szybkie ustawienia</div>
      <div class="nt-pills nt-pad">
        <button type="button" class="nt-chip" data-action="chargesPreset" data-value="once">Jednorazowy</button>
        <button type="button" class="nt-chip" data-action="chargesPreset" data-value="long3">3 / długi odpoczynek</button>
        <button type="button" class="nt-chip" data-action="chargesPreset" data-value="day1">1 / dzień</button>
      </div>
    </div>
    {{/if}}

    {{!-- 7. GOTOWE --}}
    {{#if is.done}}
    <div class="nt-tip">
      <div class="nt-tip-head">
        <button type="button" class="nt-portrait" data-action="pickImage" aria-label="Zmień obraz"><img src="{{img}}" alt=""></button>
        <div><div class="nt-tip-name nt-name">{{name}}</div><div class="nt-hint">{{typeLabel}}{{#if subtypeLabel}} · {{subtypeLabel}}{{/if}}</div></div>
      </div>
      {{#if tags.length}}<div class="nt-pills">{{#each tags}}<span class="nt-tag">{{this}}</span>{{/each}}</div>{{/if}}
      {{#each summary}}
      <div class="nt-line"><b>{{label}}:</b> {{text}} <button type="button" class="nt-link" data-action="go" data-step="{{step}}">zmień</button></div>
      {{else}}
      <div class="nt-line nt-muted">Zwykły przedmiot, bez efektów i użycia.</div>
      {{/each}}
    </div>
    {{#if impact}}
    <div class="nt-tip nt-impact">
      <div class="nt-legend nt-flush">Wpływ na: {{impact.actorName}}</div>
      {{#if impact.error}}<p class="nt-line nt-muted">Nie udało się policzyć wpływu ({{impact.error}}).</p>{{/if}}
      {{#each impact.rows}}
      <div class="nt-irow"><span>{{label}}</span><span class="nt-muted">{{before}}</span><span aria-hidden="true">→</span><span class="nt-{{cls}}">{{after}}</span></div>
      {{/each}}
      {{#each impact.notes}}<div class="nt-line nt-muted">{{this}}</div>{{/each}}
      {{#each impact.warnings}}<div class="nt-line nt-warn">⚠ {{this}}</div>{{/each}}
      <div class="nt-line nt-muted nt-small">Liczone na kopii postaci w pamięci – nic nie jest zapisywane.</div>
    </div>
    {{/if}}
    <div class="nt-card">
      <label class="nt-fg"><span>Dla kogo</span>
        <select data-field="destination.actorId"><option value="">— tylko katalog przedmiotów —</option>
          {{#each actors}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
        </select>
      </label>
      {{#if selectedActor}}
      <label class="nt-sentence nt-light"><input type="checkbox" class="nt-check" data-field="item.equipped" {{#if s.item.equipped}}checked{{/if}}> Od razu założony{{#if s.item.attunement}} i dostrojony{{/if}}</label>
      {{else}}{{#if folders.length}}
      <label class="nt-fg"><span>Folder</span>
        <select data-field="destination.folder"><option value="">—</option>{{#each folders}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>
      </label>
      {{/if}}{{/if}}
      <label class="nt-sentence nt-light"><input type="checkbox" class="nt-check" data-field="destination.openSheet" {{#if s.destination.openSheet}}checked{{/if}}> Po utworzeniu otwórz kartę systemu</label>
    </div>
    {{/if}}

    {{!-- EDYCJA: PRZEGLĄD --}}
    {{#if is.overview}}
    <ol class="nt-card nt-list">
      {{#each overview}}
      <li>
        <button type="button" class="nt-row nt-row-tall" data-action="go" data-step="{{step}}" {{#if intent}}data-intent="{{intent}}"{{/if}}>
          <i class="nt-ic {{icon}} {{#if empty}}nt-muted{{/if}}" aria-hidden="true"></i>
          <span class="nt-lb">{{label}}<span class="nt-hint">{{hint}}</span></span>
          {{#if empty}}<span class="nt-add">+ dodaj</span>{{else}}<i class="fa-solid fa-chevron-right nt-go" aria-hidden="true"></i>{{/if}}
        </button>
      </li>
      {{/each}}
    </ol>
    <div class="nt-card"><p class="nt-note">Edytor zmienia tylko to, co widzisz. Zmiany dodane ręcznie w karcie systemu, inne aktywności i sformatowany opis (jeśli go nie ruszasz) zostają bez zmian.</p></div>
    {{/if}}
  </section>

  <footer class="nt-foot">
    {{#if editing}}
      {{#if is.overview}}
      <button type="button" class="nt-btn nt-sec" data-action="openSheet"><i class="fa-solid fa-file-lines"></i> Karta systemu</button>
      {{else}}
      <button type="button" class="nt-btn nt-sec" data-action="prev"><i class="fa-solid fa-chevron-left"></i> Przegląd</button>
      {{/if}}
      <button type="button" class="nt-btn" data-action="create"><i class="fa-solid fa-check"></i> Zapisz zmiany</button>
    {{else}}
      {{#unless isFirst}}<button type="button" class="nt-btn nt-sec" data-action="prev"><i class="fa-solid fa-chevron-left"></i> Wstecz</button>{{/unless}}
      {{#if isLast}}
      <button type="button" class="nt-btn" data-action="create"><i class="fa-solid fa-check"></i> {{#if selectedActor}}Dodaj do: {{selectedActor}}{{else}}Utwórz przedmiot{{/if}}</button>
      {{else}}
      <button type="button" class="nt-btn" data-action="next">Dalej <i class="fa-solid fa-chevron-right"></i></button>
      {{/if}}
    {{/if}}
  </footer>
</div>
